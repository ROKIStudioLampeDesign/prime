// Cloudflare Workers (static assets) config used by Workers Builds on every push to main.
// `single-page-application` serves index.html for unknown paths so deep links like /gym/workout/12
// work on reload. `_headers` in dist/ is applied natively.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prime",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}

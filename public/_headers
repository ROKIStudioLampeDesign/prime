# Cloudflare Pages headers (also understood by Netlify). See DEPLOY.md.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' https://world.openfoodfacts.org https://images.openfoodfacts.org; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# The service worker and its entry points must never be cached by the browser or CDN,
# otherwise users would stay on an old version.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Hashed build assets never change: cache them forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
